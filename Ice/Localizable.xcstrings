    "Ice can work in a limited mode without this permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice kann ohne diese Berechtigung im eingeschränkten Modus arbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice puede funcionar en modo limitado sin este permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice peut fonctionner en mode limité sans cette autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice può funzionare in modalità limitata senza questo permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この権限がなくても、Iceは制限モードで動作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한이 없어도 Ice는 제한 모드로 작동할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ice pode funcionar em modo limitado sem esta permissão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 可在无此权限的情况下以受限模式运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有此權限時，Ice 仍可在受限模式下運作。"
          }
        }
      }
    },
    "Ice cannot arrange menu bar items in automatically hidden menu bars.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice kann Objekte in automatisch ausgeblendeten Menüleisten nicht anordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice no puede organizar los elementos en barras de menús que se ocultan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice ne peut pas organiser les éléments des barres des menus masquées automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice non può disporre gli elementi nelle barre dei menu nascoste automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に隠れるメニューバーでは、Iceはメニューバー項目を並べ替えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 숨겨지는 메뉴 막대에서는 Ice가 메뉴 막대 항목을 정렬할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ice não consegue organizar itens em barras de menus ocultadas automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 无法在自动隐藏的菜单栏中排列菜单栏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 無法在自動隱藏的選單列中排列選單列項目。"
          }
        }
      }
    },
    "Ice cannot display menu bar items for automatically hidden menu bars": {
      "localizations": {
