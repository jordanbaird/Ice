    "Absolutely no personal information is collected or stored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keinerlei persönliche Daten erfasst oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recopila ni almacena ninguna información personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information personnelle n’est collectée ni stockée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene raccolta né memorizzata alcuna informazione personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人情報は一切収集・保存しません。"
