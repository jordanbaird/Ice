        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el cursor sobre un área vacía de la barra de menús para mostrar los elementos ocultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez une zone vide de la barre des menus pour afficher les éléments masqués."
          }
