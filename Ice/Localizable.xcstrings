        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice se reiniciará para usar el idioma seleccionado. Los demás ajustes se conservarán."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 將重新啟動以使用所選語言，其他設定會保留。"
