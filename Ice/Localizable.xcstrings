    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此设置会重新启动所有带有菜单栏项目的应用，部分应用可能需要手动重启。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定を適用すると、メニューバー項目を持つすべてのアプリが再起動します。一部のアプリは手動で再起動する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 적용하면 메뉴 막대 항목이 있는 모든 앱이 다시 시작됩니다. 일부 앱은 직접 다시 시작해야 할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage relancera toutes les applications ayant des éléments dans la barre des menus. Certaines devront être relancées manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellung startet alle Apps mit Menüleistenelementen neu. Einige Apps müssen möglicherweise manuell neu gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste reiniciará todas las apps con elementos en la barra de menús. Es posible que algunas deban reiniciarse manualmente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用此設定將重新啟動所有具有選單列項目的應用程式。部分應用程式可能需要手動重新啟動。"
          }
        }
      }
    },
