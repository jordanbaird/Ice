    "Apply different settings based on the current system appearance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nach aktuellem Erscheinungsbild des Systems unterschiedliche Einstellungen anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar ajustes distintos según la apariencia actual del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer des réglages différents selon l’apparence actuelle du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica impostazioni diverse in base all’aspetto attuale del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のシステムの外観に応じて異なる設定を適用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시스템 화면 모드에 따라 다른 설정 적용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar ajustes diferentes com base na aparência atual do sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据当前系统外观应用不同设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依據目前的系統外觀套用不同的設定。"
          }
        }
      }
    },
