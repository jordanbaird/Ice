    "Note: You may need to log out and back in for this setting to apply properly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: You may need to log out and back in for this setting to apply properly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：可能需要退出登录后重新登录，才能使此设置正常生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：設定を正しく適用するには、ログアウトして再度ログインする必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고: 설정을 올바르게 적용하려면 로그아웃한 후 다시 로그인해야 할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque : il peut être nécessaire de fermer puis de rouvrir votre session pour appliquer correctement ce réglage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Möglicherweise musst du dich ab- und wieder anmelden, damit diese Einstellung korrekt angewendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: puede que debas cerrar sesión y volver a iniciarla para aplicar correctamente este ajuste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：可能需要登出後重新登入，此設定才會正常生效。"
          }
        }
      }
    },
