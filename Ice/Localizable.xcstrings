    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anwenden dieser Einstellung werden alle Apps mit Menüleistenobjekten neu gestartet. Einige Apps müssen eventuell manuell neu gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar este ajuste se reiniciarán todas las apps con elementos en la barra de menús. Puede que algunas apps deban reiniciarse manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application de ce réglage relancera toutes les apps ayant des éléments dans la barre des menus. Certaines apps devront peut-être être relancées manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicando questa impostazione verranno riavviate tutte le app con elementi nella barra dei menu. Alcune app potrebbero dover essere riavviate manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定を適用すると、メニューバー項目を持つすべてのアプリが再起動されます。一部のアプリは手動で再起動する必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 적용하면 메뉴 막대 항목이 있는 모든 앱이 재실행됩니다. 일부 앱은 수동으로 재실행해야 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar este ajuste reiniciará todos os apps com itens na barra de menus. Alguns apps podem precisar ser reiniciados manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此设置将重启所有带有菜单栏项目的应用。部分应用可能需要手动重启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用此設定會重新啟動所有含有選單列項目的 App。部分 App 可能需要手動重新啟動。"
          }
        }
      }
    },
