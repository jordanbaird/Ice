    "Accessibility permission is required to continue. Screen Recording is a separate permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required to continue. Screen Recording is a separate permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用需要开启“辅助功能”权限，它与“屏幕录制”是两项独立权限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するにはアクセシビリティの許可が必要です。画面収録は別の権限です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 손쉬운 사용 권한이 필요합니다. 화면 기록은 별도의 권한입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’accessibilité est nécessaire pour continuer. L’enregistrement de l’écran nécessite une autorisation distincte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Fortfahren ist die Berechtigung für Bedienungshilfen erforderlich. Bildschirmaufnahme ist eine separate Berechtigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita el permiso de accesibilidad para continuar. La grabación de pantalla requiere un permiso independiente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用需要開啟“輔助使用”權限，它與“螢幕錄製”是兩項獨立權限。"
          }
        }
      }
    },
