        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떠한 개인 정보도 수집하거나 저장하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma informação pessoal é coletada ou armazenada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不收集或存储任何个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不收集或儲存任何個人資訊。"
