    "Right-click in an empty area of the menu bar to display a minimal version of Ice's menu. Disable this setting if you encounter conflicts with other apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick in einen leeren Bereich der Menüleiste zeigt eine reduzierte Version des Ice-Menüs. Deaktiviere diese Einstellung bei Konflikten mit anderen Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un área vacía de la barra de menús para mostrar una versión reducida del menú de Ice. Desactiva este ajuste si tienes conflictos con otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton droit dans une zone vide de la barre des menus pour afficher une version réduite du menu d’Ice. Désactivez ce réglage en cas de conflit avec d’autres apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro in un’area vuota della barra dei menu per mostrare una versione ridotta del menu di Ice. Disattiva questa impostazione se riscontri conflitti con altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの空いている部分を右クリックすると、Iceの簡易メニューが表示されます。ほかのアプリと競合する場合はこの設定をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 빈 영역을 오른쪽 클릭하면 Ice 메뉴의 간소화된 버전이 표시됩니다. 다른 앱과 충돌이 발생하면 이 설정을 끄십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em uma área vazia da barra de menus para exibir uma versão reduzida do menu do Ice. Desative este ajuste se houver conflitos com outros apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏的空白区域右键点按可显示精简版的 Ice 菜单。如果与其他 App 冲突，请停用此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列的空白區域按右鍵可顯示精簡版的 Ice 選單。如果與其他 App 衝突，請停用此設定。"
          }
        }
      }
    },
