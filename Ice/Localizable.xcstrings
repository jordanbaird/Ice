    "Menu bar items are rehidden when the focused app changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleistenobjekte werden wieder ausgeblendet, wenn die aktive App wechselt."
          }
        },
        "es": {
