    "Ice can work in a limited mode without this permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice can work in a limited mode without this permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有此权限，Ice 仍可以受限模式运行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この権限がなくても、Ice は制限モードで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한 없이도 Ice를 제한 모드로 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice peut fonctionner en mode limité sans cette autorisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice kann ohne diese Berechtigung eingeschränkt verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice puede funcionar en modo limitado sin este permiso."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有此權限，Ice 仍可以受限模式運行。"
          }
        }
      }
    },
    "Ice cannot arrange menu bar items in automatically hidden menu bars": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice cannot arrange menu bar items in automatically hidden menu bars"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏设为自动隐藏时，Ice 无法排列其中的项目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に隠れるメニューバーでは、Ice は項目を並べ替えられません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 숨겨지는 메뉴 막대에서는 항목을 정렬할 수 없습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice ne peut pas organiser les éléments d’une barre des menus masquée automatiquement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice kann Elemente in automatisch ausgeblendeten Menüleisten nicht anordnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice no puede organizar los elementos de una barra de menús que se oculta automáticamente"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列設為自動隱藏時，Ice 無法排列其中的項目"
          }
        }
      }
    },
