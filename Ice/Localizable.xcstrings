    "Note: You may need to log out and back in for this setting to apply properly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Du musst dich eventuell ab- und wieder anmelden, damit diese Einstellung richtig wirksam wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: puede que tengas que cerrar sesión y volver a iniciarla para que este ajuste se aplique correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque : vous devrez peut-être fermer la session et la rouvrir pour que ce réglage s’applique correctement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: potrebbe essere necessario uscire e ripetere il login perché questa impostazione venga applicata correttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注: この設定を正しく適用するには、ログアウトして再度ログインする必要がある場合があります。"
          }
        },
        "ko": {
