    "Absolutely no personal information is collected or stored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutely no personal information is collected or stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不收集或存储任何个人信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人情報を収集・保存することは一切ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 정보를 수집하거나 저장하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information personnelle n’est collectée ni conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keinerlei persönliche Daten erfasst oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recopila ni almacena ningún dato personal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不收集或儲存任何個人資訊。"
          }
        }
      }
    },
    "Accessibility": {
      "extractionState": "manual",
