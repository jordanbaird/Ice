        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dans une zone vide de la barre des menus pour afficher les éléments masqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic in un’area vuota della barra dei menu per mostrare gli elementi nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの空いている部分をクリックして、隠れているメニューバー項目を表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 빈 영역을 클릭하여 숨겨진 메뉴 막대 항목 표시."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma área vazia da barra de menus para mostrar os itens ocultos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击菜单栏内部空白区域以展示被隐藏的菜单栏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列的空白區域以顯示隱藏的選單列項目。"
          }
        }
      }
    },
    "Click the Ice icon in the menu bar to show or hide the items in the hidden section.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Ice-Symbol in der Menüleiste, um die Objekte im ausgeblendeten Bereich ein- oder auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de Ice en la barra de menús para mostrar u ocultar los elementos de la sección oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône d’Ice dans la barre des menus pour afficher ou masquer les éléments de la section masquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’icona di Ice nella barra dei menu per mostrare o nascondere gli elementi della sezione nascosta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのIceアイコンをクリックすると、「非表示」セクションの項目を表示または非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 Ice 아이콘을 클릭하면 숨김 섹션의 항목을 표시하거나 숨길 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone do Ice na barra de menus para mostrar ou ocultar os itens da seção oculta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏中的 Ice 图标，即可显示或隐藏“隐藏”版块中的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列中的 Ice 圖像，即可顯示或隱藏「隱藏」區段中的項目。"
          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access Ice's settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um ausgeblendete Menüleistenobjekte anzuzeigen. Rechtsklick öffnet die Einstellungen von Ice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para mostrar los elementos ocultos de la barra de menús. Haz clic derecho para acceder a los ajustes de Ice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour afficher les éléments masqués de la barre des menus. Cliquez avec le bouton droit pour accéder aux réglages d’Ice."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per mostrare gli elementi nascosti della barra dei menu. Fai clic destro per accedere alle impostazioni di Ice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックすると隠れているメニューバー項目を表示します。右クリックでIceの設定を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 숨겨진 메뉴 막대 항목을 표시합니다. 오른쪽 클릭하면 Ice 설정에 접근합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para mostrar os itens ocultos da barra de menus. Clique com o botão direito para acessar os ajustes do Ice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以显示隐藏的菜单栏项目。右键点按以访问 Ice 的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下以顯示隱藏的選單列項目。按右鍵以存取 Ice 的設定。"
          }
        }
      }
    },
