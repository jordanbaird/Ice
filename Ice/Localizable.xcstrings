    "Animate the Ice Bar when expanding and collapsing. Respects Reduce Motion in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animate the Ice Bar when expanding and collapsing. Respects Reduce Motion in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Ice 扩展栏启用淡入淡出效果；系统开启“减少动态效果”时不播放动画。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar の展開・折りたたみ時にアニメーションを使用します。システム設定の「視差効果を減らす」に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Bar를 펼치거나 접을 때 애니메이션을 사용합니다. 시스템 설정의 동작 줄이기를 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anime l’ouverture et la fermeture d’Ice Bar. Respecte l’option Réduire les animations de Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiert das Ein- und Ausblenden von Ice Bar. Berücksichtigt „Bewegung reduzieren“ in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima la apertura y el cierre de Ice Bar. Respeta la opción Reducir movimiento de Ajustes del Sistema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Ice 延伸列啟用淡入淡出效果；系統開啟「減少動態效果」時不播放動畫。"
          }
        }
      }
    },
