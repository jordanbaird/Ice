    "Tip: you can also arrange menu bar items by Command + dragging them in the menu bar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: you can also arrange menu bar items by Command + dragging them in the menu bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：也可按住 Command 键，在菜单栏中拖动项目来调整顺序"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：Command キーを押しながらメニューバー項目をドラッグしても並べ替えられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: Command 키를 누른 채 메뉴 막대 항목을 드래그해도 정렬할 수 있습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : vous pouvez aussi déplacer les éléments dans la barre des menus en maintenant Commande"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Elemente lassen sich auch mit gedrückter Befehlstaste direkt in der Menüleiste verschieben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: también puedes organizar los elementos arrastrándolos en la barra de menús con la tecla Comando pulsada"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：也可按住 Command 鍵，在選單列中拖動項目來調整順序"
          }
        }
      }
    },
    "Tip: you can also edit these settings by right-clicking in an empty area of the menu bar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: you can also edit these settings by right-clicking in an empty area of the menu bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：也可右键点击菜单栏空白处，修改这些设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：メニューバーの空白部分を右クリックしても、これらの設定を編集できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 메뉴 막대의 빈 공간을 오른쪽 클릭해도 이 설정을 편집할 수 있습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : un clic droit dans une zone vide de la barre des menus permet aussi de modifier ces réglages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Diese Einstellungen lassen sich auch per Rechtsklick auf einen leeren Menüleistenbereich bearbeiten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: también puedes editar estos ajustes haciendo clic derecho en un espacio vacío de la barra de menús"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：也可右鍵按一下選單列空白處，修改這些設定"
          }
        }
      }
