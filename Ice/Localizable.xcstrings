{
  "sourceLanguage": "en",
  "strings": {
    "%@ Item": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt „%@“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemento %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élément %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemento %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の項目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 항목"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Item %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 項目"
          }
        }
      }
    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reagiert nicht. Bis zum Neustart kann es nicht bewegt werden. Das Bewegen anderer Menüleistenobjekte kann ebenfalls beeinträchtigt sein, bis das Problem behoben ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no responde. Hasta que se reinicie, no se puede mover. El movimiento de otros elementos de la barra de menús también puede verse afectado hasta que se resuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas. Tant qu’il n’est pas redémarré, il ne peut pas être déplacé. Le déplacement des autres éléments de la barre des menus peut aussi être affecté jusqu’à résolution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non risponde. Finché non viene riavviato, non può essere spostato. Anche lo spostamento degli altri elementi della barra dei menu potrebbe risentirne finché il problema non viene risolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が応答していません。再起動されるまで移動できません。解決するまで、ほかのメニューバー項目の移動にも影響する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 응답하지 않습니다. 재시작될 때까지 이동할 수 없습니다. 이 문제가 해결될 때까지 다른 메뉴 막대 항목의 이동에도 영향이 있을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está respondendo. Até que seja reiniciado, ele não pode ser movido. A movimentação de outros itens da barra de menus também pode ser afetada até que isso seja resolvido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无响应。在它重新启动前无法移动；在问题解决前，其他菜单栏项目的移动也可能受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@沒有回應。在重新啟動之前無法移動；在問題解決之前，其他選單列項目的移動也可能受到影響。"
          }
        }
      }
    },
