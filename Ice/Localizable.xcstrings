    "Hide app menus when showing menu bar items": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Menüs ausblenden, wenn Menüleistenobjekte angezeigt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar los menús de la app al mostrar los elementos de la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les menus de l’app lors de l’affichage des éléments de la barre des menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi i menu dell’app quando vengono mostrati gli elementi della barra dei menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目の表示中はアプリケーションメニューを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 항목을 표시할 때 응용 프로그램 메뉴 가리기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar os menus do app ao mostrar os itens da barra de menus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示菜单栏项目时隐藏应用程序菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示選單列項目時隱藏應用程式選單"
          }
        }
      }
    },
    "Hold Command and drag an item in the menu bar to move it to a different section, or drag items in the Menu Bar Layout settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Befehlstaste gedrückt und ziehe ein Objekt in der Menüleiste in einen anderen Bereich, oder ziehe Objekte in den Einstellungen unter „Menüleistenlayout“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla Comando y arrastra un elemento de la barra de menús para moverlo a otra sección, o arrastra los elementos en los ajustes de Disposición de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche Commande enfoncée et faites glisser un élément de la barre des menus pour le déplacer vers une autre section, ou faites glisser les éléments dans les réglages Disposition de la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Comando e trascina un elemento nella barra dei menu per spostarlo in un’altra sezione, oppure trascina gli elementi nelle impostazioni Layout della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandキーを押しながらメニューバーの項目をドラッグすると別のセクションに移動できます。「メニューバーのレイアウト」設定で項目をドラッグすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 키를 누른 채 메뉴 막대의 항목을 드래그하면 다른 섹션으로 이동할 수 있습니다. 메뉴 막대 레이아웃 설정에서 항목을 드래그할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a tecla Comando pressionada e arraste um item na barra de menus para movê-lo para outra seção, ou arraste os itens nos ajustes de Layout da barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 键并拖移菜单栏中的项目，即可将其移到其他版块；也可以在“菜单栏布局”设置中拖移项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 鍵並拖移選單列中的項目，即可將其移至其他區段；也可以在「選單列佈局」設定中拖移項目。"
          }
        }
      }
    },
    "Hold Option and click the Ice icon to show or hide the items in the always-hidden section.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Wahltaste gedrückt und klicke auf das Ice-Symbol, um die Objekte im immer ausgeblendeten Bereich ein- oder auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla Opción y haz clic en el icono de Ice para mostrar u ocultar los elementos de la sección siempre oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche Option enfoncée et cliquez sur l’icône d’Ice pour afficher ou masquer les éléments de la section toujours masquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Opzione e fai clic sull’icona di Ice per mostrare o nascondere gli elementi della sezione sempre nascosta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionキーを押しながらIceアイコンをクリックすると、「常に非表示」セクションの項目を表示または非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option 키를 누른 채 Ice 아이콘을 클릭하면 항상 숨김 섹션의 항목을 표시하거나 숨길 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a tecla Opção pressionada e clique no ícone do Ice para mostrar ou ocultar os itens da seção sempre oculta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Option 键并点按 Ice 图标，即可显示或隐藏“始终隐藏”版块中的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Option 鍵並按一下 Ice 圖像，即可顯示或隱藏「永遠隱藏」區段中的項目。"
          }
        }
      }
    },
