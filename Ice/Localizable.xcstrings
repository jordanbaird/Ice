    "Assign keyboard shortcuts in the Hotkeys settings to toggle sections, search menu bar items, and more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weise in den Einstellungen unter „Tastenkürzel“ Kurzbefehle zu, um Bereiche ein- und auszublenden, Menüleistenobjekte zu suchen und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna atajos de teclado en los ajustes de Atajos para mostrar u ocultar secciones, buscar elementos de la barra de menús y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez des raccourcis clavier dans les réglages Raccourcis pour afficher ou masquer des sections, rechercher des éléments de la barre des menus et plus encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna abbreviazioni da tastiera nelle impostazioni Abbreviazioni per mostrare o nascondere le sezioni, cercare elementi della barra dei menu e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホットキー」設定でキーボードショートカットを割り当てると、セクションの切り替えやメニューバー項目の検索などができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 설정에서 키보드 단축키를 지정하면 섹션 전환, 메뉴 막대 항목 검색 등을 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua atalhos de teclado nos ajustes de Atalhos para mostrar ou ocultar seções, buscar itens da barra de menus e muito mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“快捷键”设置中指定键盘快捷键，即可切换版块、搜索菜单栏项目等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「快速鍵」設定中指定鍵盤快速鍵，即可切換區段、搜尋選單列項目等。"
          }
        }
      }
    },
