    "Due to a bug in the 0.10.0 release, the data for Ice's menu bar items was corrupted and their positions had to be reset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to a bug in the 0.10.0 release, the data for Ice's menu bar items was corrupted and their positions had to be reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 0.10.0 版本的缺陷，Ice 的菜单栏项目数据已损坏，相关位置已重置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 0.10.0 の不具合により Ice のメニューバー項目データが破損したため、配置をリセットしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.10.0 버전의 오류로 Ice의 메뉴 막대 항목 데이터가 손상되어 위치를 재설정했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bug de la version 0.10.0 a corrompu les données des éléments de la barre des menus d’Ice. Leurs positions ont dû être réinitialisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch einen Fehler in Version 0.10.0 wurden die Daten der Ice-Menüleistenelemente beschädigt. Ihre Positionen mussten zurückgesetzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un error de la versión 0.10.0 dañó los datos de los elementos de la barra de menús de Ice. Fue necesario restablecer sus posiciones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 0.10.0 版本的缺陷，Ice 的選單列項目數據已損壞，相關位置已重置。"
          }
        }
