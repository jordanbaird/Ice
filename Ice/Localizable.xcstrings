    "Make more room in the menu bar by hiding the left application menus if needed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make more room in the menu bar by hiding the left application menus if needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要时隐藏左侧的应用菜单，为菜单栏腾出空间"
