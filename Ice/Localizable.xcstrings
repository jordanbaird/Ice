    "\"%@\" is invalid": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无效"
          }
        }
      }
    },
    "\"%@\" is not movable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移动“%@”"
