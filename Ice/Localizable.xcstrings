    "Menu bar items are rehidden after a fixed amount of time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleistenobjekte werden nach einer festen Zeit wieder ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos se vuelven a ocultar tras un tiempo fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sont masqués à nouveau après un délai fixe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi vengono nascosti di nuovo dopo un tempo fisso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一定時間後にメニューバー項目を再び隠す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 시간이 지나면 메뉴 막대 항목을 다시 숨김."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
