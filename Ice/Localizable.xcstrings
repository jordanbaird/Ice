    "Ice will restart to use the selected language. Your other settings will be preserved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice will restart to use the selected language. Your other settings will be preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice 将重新启动以使用所选语言，其他设置会保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した言語を適用するため Ice を再起動します。他の設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어를 적용하기 위해 Ice를 다시 시작합니다. 다른 설정은 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
