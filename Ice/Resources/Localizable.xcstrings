  "strings": {
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está respondendo. Enquanto não for reiniciado, ele não pode ser movido. O movimento de outros itens da barra de menus também pode ser afetado até que isso seja resolvido."
          }
        }
      }
    },
